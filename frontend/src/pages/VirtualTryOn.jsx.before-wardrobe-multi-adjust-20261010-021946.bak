import { useLocation } from 'react-router-dom'
import { useEffect, useRef, useState } from 'react'
import axios from 'axios'
import TryOnAdjuster from '../components/TryOnAdjuster'
import {
    Camera,
    Check,
    Download,
    Move,
    RefreshCw,
    Save,
    Sparkles,
    Upload,
    User,
    X
} from 'lucide-react'

const API_TRYON = '/api/agent/vton'
const API_HISTORY = '/api/agent/vton/history'

function fileToDataUrl(file, preserveTransparency = false) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onload = () => {
            const img = new Image()
            img.onload = () => {
                const maxDim = 1200
                let width = img.naturalWidth || img.width
                let height = img.naturalHeight || img.height
                if (width > maxDim || height > maxDim) {
                    const ratio = maxDim / Math.max(width, height)
                    width = Math.round(width * ratio)
                    height = Math.round(height * ratio)
                }
                const canvas = document.createElement('canvas')
                canvas.width = width
                canvas.height = height
                const ctx = canvas.getContext('2d')
                ctx.clearRect(0, 0, width, height)
                ctx.drawImage(img, 0, 0, width, height)
                // Keep transparent garment backgrounds as PNG. Model photos are compressed as JPEG to save memory.
                resolve(preserveTransparency
                    ? canvas.toDataURL('image/png')
                    : canvas.toDataURL('image/jpeg', 0.85))
            }
            img.onerror = () => resolve(reader.result)
            img.src = reader.result
        }
        reader.onerror = reject
        reader.readAsDataURL(file)
    })
}

export default function VirtualTryOn() {
    const location = useLocation()
    const [modelImage, setModelImage] = useState(null)
    const [clothingImage, setClothingImage] = useState(null)
    // Keep a separate garment for each slot so Upper and Lower can be combined.
    const [garmentsByCategory, setGarmentsByCategory] = useState({ upper_body: null, lower_body: null, dresses: null })
    const [garmentName, setGarmentName] = useState('')
    const [category, setCategory] = useState('upper_body')
    const [resultImage, setResultImage] = useState(null)
    const [isAdjusting, setIsAdjusting] = useState(false)
    const [processing, setProcessing] = useState(false)
    const [saving, setSaving] = useState(false)
    const [status, setStatus] = useState(null)
    const [history, setHistory] = useState([])

    const [cameraOpen, setCameraOpen] = useState(false)
    const [cameraStream, setCameraStream] = useState(null)
    const videoRef = useRef(null)

    const modelInputRef = useRef(null)
    const clothingInputRef = useRef(null)

    const message = (text, type = 'info') => setStatus({ text, type })

    // Prefill the selected wardrobe garment after clicking "Try On Look".
    useEffect(() => {
        let item = location.state?.wardrobeItem
        if (!item) {
            const encodedItem = new URLSearchParams(location.search).get('item')
            if (encodedItem) {
                try { item = JSON.parse(encodedItem) }
                catch (error) { console.warn('[Wardrobe Try-On] Could not parse selected item:', error) }
            }
        }
        if (!item || typeof item !== 'object' || !item.imageSrc) return

        const description = `${item.name || ''} ${item.category || ''}`.toLowerCase()
        let selectedCategory = item.tryOnCategory || 'upper_body'
        if (!item.tryOnCategory) {
            if (/\b(dress|gown|jumpsuit|romper)\b/.test(description)) selectedCategory = 'dresses'
            else if (/\b(jeans?|trousers?|pants?|shorts?|skirt|leggings?|bottoms?|chinos)\b/.test(description)) selectedCategory = 'lower_body'
        }

        setClothingImage(item.imageSrc)
        setGarmentName(item.name || 'Wardrobe garment')
        setCategory(selectedCategory)
        setResultImage(null)
        setIsAdjusting(false)
        setStatus({
            text: `Loaded "${item.name || 'wardrobe item'}" from your wardrobe. Upload or capture a model photo to continue.`,
            type: 'info'
        })
    }, [location.key, location.search, location.state])


    useEffect(() => {
        return () => {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop())
            }
        }
    }, [cameraStream])

    const loadHistory = async () => {
        try {
            const response = await axios.get(API_HISTORY)
            setHistory(response.data?.data || response.data || [])
        } catch {
            setHistory([])
        }
    }

    useEffect(() => {
        loadHistory()
    }, [])

    const handleImageSelect = async (event, type) => {
        const file = event.target.files?.[0]
        if (!file) return

        if (!file.type.startsWith('image/')) {
            message('Please choose a JPG, PNG or WebP image.', 'error')
            return
        }

        if (file.size > 10 * 1024 * 1024) {
            message('Image must be 10 MB or smaller.', 'error')
            return
        }

        try {
            const dataUrl = await fileToDataUrl(file, type === 'clothing')

            if (type === 'model') {
                setModelImage(dataUrl)
            } else {
                const uploadedName = file.name.replace(/\.[^/.]+$/, '')
                setClothingImage(dataUrl)
                setGarmentName(uploadedName)
                setGarmentsByCategory(prev => ({
                    ...prev,
                    [category]: { image: dataUrl, name: uploadedName, category }
                }))
            }

            setResultImage(null)
            setStatus(null)
        } catch {
            message('Unable to read that image.', 'error')
        } finally {
            event.target.value = ''
        }
    }

    const startCamera = async () => {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 720 }, height: { ideal: 960 }, facingMode: 'user' }
            })

            setCameraStream(stream)
            setCameraOpen(true)

            requestAnimationFrame(() => {
                if (videoRef.current) {
                    videoRef.current.srcObject = stream
                    videoRef.current.play().catch(() => {})
                }
            })
        } catch {
            message('Camera permission was denied or no camera is available.', 'error')
        }
    }

    const closeCamera = () => {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop())
        }
        setCameraStream(null)
        setCameraOpen(false)
    }

    const captureCamera = () => {
        const video = videoRef.current
        if (!video) return

        const canvas = document.createElement('canvas')
        canvas.width = video.videoWidth || 720
        canvas.height = video.videoHeight || 960
        const context = canvas.getContext('2d')

        context.drawImage(video, 0, 0, canvas.width, canvas.height)
        setModelImage(canvas.toDataURL('image/png'))
        setResultImage(null)
        closeCamera()
        message('Model photo captured from camera.', 'success')
    }

function generateClientSideTryOn(modelImgUrl, clothingImgUrl, garmentCategory = 'upper_body') {
    // Approximate local 2D composition fallback. Transparent wardrobe cutouts are
    // preserved; uniform white photo backgrounds are removed only when connected to edges.
    return new Promise((resolve, reject) => {
        const loadImage = (src) => new Promise((resolveImage, rejectImage) => {
            const image = new Image()
            image.onload = () => resolveImage(image)
            image.onerror = () => rejectImage(new Error('Unable to load the model or garment image.'))
            if (/^https?:\/\//i.test(src)) image.crossOrigin = 'anonymous'
            image.src = src
        })

        Promise.all([loadImage(modelImgUrl), loadImage(clothingImgUrl)])
            .then(([modelImg, clothingImg]) => {
                const width = modelImg.naturalWidth || modelImg.width || 720
                const height = modelImg.naturalHeight || modelImg.height || 960
                const output = document.createElement('canvas')
                output.width = width
                output.height = height
                const outCtx = output.getContext('2d')
                if (!outCtx) throw new Error('Canvas is unavailable in this browser.')
                outCtx.drawImage(modelImg, 0, 0, width, height)

                const garmentCanvas = document.createElement('canvas')
                garmentCanvas.width = clothingImg.naturalWidth || clothingImg.width
                garmentCanvas.height = clothingImg.naturalHeight || clothingImg.height
                const garmentCtx = garmentCanvas.getContext('2d', { willReadFrequently: true })
                if (!garmentCtx) throw new Error('Canvas is unavailable in this browser.')
                garmentCtx.drawImage(clothingImg, 0, 0, garmentCanvas.width, garmentCanvas.height)

                try {
                    const w = garmentCanvas.width
                    const h = garmentCanvas.height
                    const imageData = garmentCtx.getImageData(0, 0, w, h)
                    const pixels = imageData.data
                    const corners = [[0,0], [w-1,0], [0,h-1], [w-1,h-1]]
                    const hasExistingTransparency = corners.some(([x,y]) => pixels[(y*w+x)*4+3] < 250)
                    if (!hasExistingTransparency) {
                        // Only remove an edge-connected near-white background; do not erase
                        // similarly coloured pixels inside a white/cream garment.
                        const samples = corners.map(([x,y]) => {
                            const i = (y*w+x)*4
                            return [pixels[i], pixels[i+1], pixels[i+2], pixels[i+3]]
                        }).filter(c => c[3] > 250 && Math.min(c[0],c[1],c[2]) >= 220 && Math.max(c[0],c[1],c[2])-Math.min(c[0],c[1],c[2]) < 28)
                        if (samples.length) {
                            const ref = samples[0]
                            const nearBackground = (p) => {
                                const i = p*4
                                return pixels[i+3] > 0 &&
                                    pixels[i] >= 218 && pixels[i+1] >= 218 && pixels[i+2] >= 218 &&
                                    Math.abs(pixels[i]-ref[0]) <= 44 &&
                                    Math.abs(pixels[i+1]-ref[1]) <= 44 &&
                                    Math.abs(pixels[i+2]-ref[2]) <= 44
                            }
                            const queue = new Int32Array(w*h)
                            let head = 0, tail = 0
                            const visit = (x,y) => {
                                if (x<0 || y<0 || x>=w || y>=h) return
                                const p = y*w+x, ai = p*4+3
                                if (pixels[ai] === 0 || !nearBackground(p)) return
                                pixels[ai] = 0
                                queue[tail++] = p
                            }
                            for (let x=0; x<w; x++) { visit(x,0); visit(x,h-1) }
                            for (let y=1; y<h-1; y++) { visit(0,y); visit(w-1,y) }
                            while (head<tail) {
                                const p = queue[head++], x=p%w, y=Math.floor(p/w)
                                visit(x-1,y); visit(x+1,y); visit(x,y-1); visit(x,y+1)
                            }
                            garmentCtx.putImageData(imageData,0,0)
                        }
                    }
                } catch (backgroundError) {
                    console.warn('[Try-On] Preserving source background because cutout processing failed:', backgroundError.message)
                }

                const pixels = garmentCtx.getImageData(0, 0, garmentCanvas.width, garmentCanvas.height).data
                let minX=garmentCanvas.width, minY=garmentCanvas.height, maxX=-1, maxY=-1
                for (let y=0; y<garmentCanvas.height; y++) {
                    for (let x=0; x<garmentCanvas.width; x++) {
                        if (pixels[(y*garmentCanvas.width+x)*4+3] > 12) {
                            if (x<minX) minX=x
                            if (x>maxX) maxX=x
                            if (y<minY) minY=y
                            if (y>maxY) maxY=y
                        }
                    }
                }
                if (maxX < minX || maxY < minY) throw new Error('The garment image appears empty after background removal.')
                const pad = Math.max(1, Math.round(Math.min(maxX-minX+1, maxY-minY+1)*0.01))
                minX=Math.max(0,minX-pad); minY=Math.max(0,minY-pad)
                maxX=Math.min(garmentCanvas.width-1,maxX+pad); maxY=Math.min(garmentCanvas.height-1,maxY+pad)
                const cropW=maxX-minX+1, cropH=maxY-minY+1

                let region
                if (garmentCategory === 'lower_body') {
                    region = { x: width*0.29, y: height*0.465, w: width*0.42, h: height*0.50 }
                } else if (garmentCategory === 'dresses') {
                    region = { x: width*0.23, y: height*0.20, w: width*0.54, h: height*0.73 }
                } else {
                    region = { x: width*0.23, y: height*0.195, w: width*0.54, h: height*0.34 }
                }
                const fit = Math.min(region.w/cropW, region.h/cropH)
                const drawW=cropW*fit, drawH=cropH*fit
                const drawX=region.x+(region.w-drawW)/2
                const drawY=region.y+(region.h-drawH)/2
                outCtx.drawImage(garmentCanvas,minX,minY,cropW,cropH,drawX,drawY,drawW,drawH)
                resolve(output.toDataURL('image/png'))
            })
            .catch(reject)
    })
}

    // Local multi-item preview. This is an approximate 2D overlay, not a photorealistic VTON model.
    const generateClientSideMultiTryOn = async (modelImgUrl, garments) => {
        const loadImage = (src) => new Promise((resolve, reject) => {
            const image = new Image()
            image.crossOrigin = 'anonymous'
            image.onload = () => resolve(image)
            image.onerror = () => reject(new Error('Could not load one of the try-on images.'))
            image.src = src
        })

        const modelImg = await loadImage(modelImgUrl)
        const canvas = document.createElement('canvas')
        canvas.width = modelImg.naturalWidth || modelImg.width || 720
        canvas.height = modelImg.naturalHeight || modelImg.height || 960
        const ctx = canvas.getContext('2d')
        if (!ctx) throw new Error('Canvas is unavailable in this browser.')
        ctx.drawImage(modelImg, 0, 0, canvas.width, canvas.height)

        // Draw bottoms first so an upper garment can overlap the waistband naturally.
        const order = { lower_body: 0, upper_body: 1, dresses: 2 }
        const orderedGarments = [...garments].sort((a, b) => (order[a.category] ?? 1) - (order[b.category] ?? 1))

        for (const garment of orderedGarments) {
            const sourceImg = await loadImage(garment.image)
            const maxDim = 720
            const factor = Math.min(1, maxDim / Math.max(sourceImg.naturalWidth || sourceImg.width, sourceImg.naturalHeight || sourceImg.height))
            const gw = Math.max(1, Math.round((sourceImg.naturalWidth || sourceImg.width) * factor))
            const gh = Math.max(1, Math.round((sourceImg.naturalHeight || sourceImg.height) * factor))
            const cutout = document.createElement('canvas')
            cutout.width = gw
            cutout.height = gh
            const gctx = cutout.getContext('2d', { willReadFrequently: true })
            if (!gctx) continue
            gctx.drawImage(sourceImg, 0, 0, gw, gh)

            // Remove a uniform, light background only when it is connected to the image edge.
            // This helps keep a white/cream shirt's interior intact.
            try {
                const imageData = gctx.getImageData(0, 0, gw, gh)
                const pixels = imageData.data
                const samplePoints = [[0, 0], [gw - 1, 0], [0, gh - 1], [gw - 1, gh - 1]]
                let br = 0, bg = 0, bb = 0
                for (const [sx, sy] of samplePoints) {
                    const i = (sy * gw + sx) * 4
                    br += pixels[i]; bg += pixels[i + 1]; bb += pixels[i + 2]
                }
                br = Math.round(br / 4); bg = Math.round(bg / 4); bb = Math.round(bb / 4)
                const backgroundIsLight = (br + bg + bb) / 3 > 155 && Math.max(br, bg, bb) - Math.min(br, bg, bb) < 80
                if (backgroundIsLight) {
                    const total = gw * gh
                    const visited = new Uint8Array(total)
                    const queue = new Int32Array(total)
                    let head = 0, tail = 0
                    const isBackground = (p) => {
                        const i = p * 4
                        if (pixels[i + 3] === 0) return true
                        const r = pixels[i], g = pixels[i + 1], b = pixels[i + 2]
                        const brightness = (r + g + b) / 3
                        const delta = Math.abs(r - br) + Math.abs(g - bg) + Math.abs(b - bb)
                        return brightness > 145 && delta < 108
                    }
                    const add = (p) => {
                        if (p >= 0 && p < total && !visited[p] && isBackground(p)) {
                            visited[p] = 1
                            queue[tail++] = p
                        }
                    }
                    for (let x = 0; x < gw; x++) { add(x); add((gh - 1) * gw + x) }
                    for (let y = 0; y < gh; y++) { add(y * gw); add(y * gw + gw - 1) }
                    while (head < tail) {
                        const p = queue[head++]
                        pixels[p * 4 + 3] = 0
                        const x = p % gw, y = (p / gw) | 0
                        if (x > 0) add(p - 1)
                        if (x < gw - 1) add(p + 1)
                        if (y > 0) add(p - gw)
                        if (y < gh - 1) add(p + gw)
                    }
                    gctx.putImageData(imageData, 0, 0)
                }
            } catch (error) {
                // Cross-origin photos may block pixel access; draw the image as-is in that case.
                console.warn('[TryOn] Background cleanup skipped:', error?.message || error)
            }

            const W = canvas.width, H = canvas.height
            let box
            if (garment.category === 'lower_body') {
                box = { x: W * 0.245, y: H * 0.455, w: W * 0.51, h: H * 0.49 }
            } else if (garment.category === 'dresses') {
                box = { x: W * 0.205, y: H * 0.205, w: W * 0.59, h: H * 0.735 }
            } else {
                box = { x: W * 0.19, y: H * 0.215, w: W * 0.62, h: H * 0.30 }
            }
            const aspect = gw / gh
            let drawW = box.w
            let drawH = drawW / aspect
            if (drawH > box.h) { drawH = box.h; drawW = drawH * aspect }
            const x = box.x + (box.w - drawW) / 2
            const y = box.y + (box.h - drawH) / 2
            ctx.drawImage(cutout, x, y, drawW, drawH)
        }
        return canvas.toDataURL('image/jpeg', 0.92)
    }

    const generateTryOn = async () => {
        if (!modelImage) {
            message('Upload or capture a model photo first.', 'error')
            return
        }

        const selectedByCategory = { ...garmentsByCategory }
        // Include a garment loaded from Wardrobe or present in the currently visible slot.
        if (clothingImage) {
            selectedByCategory[category] = {
                ...(selectedByCategory[category] || {}),
                image: clothingImage,
                name: garmentName || selectedByCategory[category]?.name || 'Uploaded garment',
                category
            }
        }
        let selectedGarments = Object.entries(selectedByCategory)
            .filter(([, item]) => Boolean(item?.image))
            .map(([itemCategory, item]) => ({ ...item, category: itemCategory }))

        if (!selectedGarments.length) {
            message('Upload at least one garment. You can add both an Upper and a Lower item before generating.', 'error')
            return
        }

        // A dress is a full-body garment; if selected, use it on its own.
        if (selectedGarments.some(item => item.category === 'dresses')) {
            selectedGarments = [selectedGarments.find(item => item.category === 'dresses')]
        }

        setProcessing(true)
        setResultImage(null)
        message(selectedGarments.length > 1
            ? 'Combining your upper and lower garments in the preview…'
            : 'Generating your virtual try-on…', 'info')

        try {
            // The connected API accepts one garment per request, so multiple categories use the
            // local category-aware compositor rather than silently ignoring one selected item.
            if (selectedGarments.length > 1) {
                const combined = await generateClientSideMultiTryOn(modelImage, selectedGarments)
                setResultImage(combined)
                message('Upper and Lower garments are both shown. This is a local 2D preview, not AI-generated fabric fitting.', 'success')
                return
            }

            const garment = selectedGarments[0]
            try {
                const response = await axios.post(
                    API_TRYON,
                    {
                        model_image: modelImage,
                        clothing_image: garment.image,
                        category: garment.category,
                        garment_description: garment.name || 'fashion clothing'
                    },
                    { timeout: 8000 }
                )

                const result = response.data?.result_image || response.data?.resultImage
                if (!result) throw new Error(response.data?.message || 'Agent did not return a result image.')
                setResultImage(result)
                message('Virtual Try-On completed successfully.', 'success')
                loadHistory()
            } catch (apiError) {
                console.warn('[TryOn] Live single-garment try-on unavailable; showing local preview:', apiError?.message || apiError)
                const localResult = await generateClientSideMultiTryOn(modelImage, [garment])
                setResultImage(localResult)
                message('Preview created with category-aware garment placement. Live AI fitting was unavailable; this is an approximate 2D overlay.', 'info')
            }
        } catch (error) {
            console.error('[TryOn] Preview generation failed:', error)
            message(error?.message || 'Virtual Try-On preview could not be generated.', 'error')
        } finally {
            setProcessing(false)
        }
    }

    const downloadResult = () => {
        if (!resultImage) return
        const link = document.createElement('a')
        link.href = resultImage
        link.download = `style-silhouette-tryon-${Date.now()}.png`
        document.body.appendChild(link)
        link.click()
        link.remove()
    }

    const saveResult = async () => {
        if (!resultImage || saving) return

        setSaving(true)

        try {
            await axios.post(`${API_HISTORY}/save`, {
                title: garmentName ? `Try-On: ${garmentName}` : 'AI Agent Virtual Try-On',
                baseImage: modelImage,
                clothingItems: [{
                    name: garmentName || 'Uploaded Garment',
                    category,
                    imageSrc: clothingImage
                }],
                resultImage
            })

            message('Try-On saved to your history.', 'success')
            loadHistory()
        } catch (error) {
            message(error?.response?.data?.message || 'Unable to save this try-on.', 'error')
        } finally {
            setSaving(false)
        }
    }

    const clearSession = () => {
        setModelImage(null)
        setClothingImage(null)
        setGarmentsByCategory({ upper_body: null, lower_body: null, dresses: null })
        setCategory('upper_body')
        setGarmentName('')
        setResultImage(null)
        setStatus(null)
        setIsAdjusting(false)
    }

    return (
        <main style={{ maxWidth: 1320, margin: '0 auto', padding: '32px 28px 60px' }}>
            <header style={{ marginBottom: 28 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 20, flexWrap: 'wrap' }}>
                    <div>
                        <p style={{ margin: 0, fontSize: 12, letterSpacing: '.12em', textTransform: 'uppercase', color: 'var(--text-muted)' }}>
                            Virtual styling studio
                        </p>
                        <h1 style={{ margin: '8px 0 6px', fontSize: 'clamp(28px, 4vw, 42px)', letterSpacing: '-.03em' }}>
                            Virtual Try-On
                        </h1>
                        <p style={{ margin: 0, color: 'var(--text-secondary)', maxWidth: 700 }}>
                            Upload your photo and a garment. The AI Agent generates the garment on the person using its built-in VTON tool.
                        </p>
                    </div>

                </div>
            </header>

            {status && (
                <div className={`alert ${status.type === 'error' ? 'alert-error' : status.type === 'success' ? 'alert-success' : 'alert-info'}`} style={{ marginBottom: 20 }}>
                    {status.text}
                </div>
            )}

                <>
                    {/* CUSTOM RESIZE AND MOVE INTERACTIVE EDITOR */}
                    {isAdjusting && modelImage && clothingImage && (
                        <div style={{ marginBottom: 24 }}>
                            <TryOnAdjuster
                                modelPhoto={modelImage}
                                clothingPhoto={clothingImage}
                                category={category}
                                onApply={(newImage) => {
                                    setResultImage(newImage)
                                    setIsAdjusting(false)
                                    message('Custom position & scale applied to Try-On result!', 'success')
                                }}
                                onClose={() => setIsAdjusting(false)}
                            />
                        </div>
                    )}

                    <section style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: 20 }}>
                        {/* STEP 1: MODEL PHOTO */}
                        <div className="card">
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12, alignItems: 'center', marginBottom: 14 }}>
                                <div>
                                    <div style={{ fontSize: 11, textTransform: 'uppercase', letterSpacing: '.1em', color: 'var(--text-muted)' }}>Step 1</div>
                                    <h2 style={{ margin: '4px 0 0', fontSize: 18 }}>Model Photo</h2>
                                </div>
                                {modelImage && <span className="badge badge-success"><Check size={12} /> Ready</span>}
                            </div>

                            <div style={{ display: 'flex', gap: 8, marginBottom: 12 }}>
                                <button className="btn btn-primary btn-sm" onClick={() => modelInputRef.current?.click()}>
                                    <Upload size={15} /> Upload Model
                                </button>
                                <button className="btn btn-secondary btn-sm" onClick={startCamera}>
                                    <Camera size={15} /> Camera
                                </button>
                            </div>

                            <input
                                ref={modelInputRef}
                                type="file"
                                accept="image/jpeg,image/png,image/webp"
                                hidden
                                onChange={event => handleImageSelect(event, 'model')}
                            />

                            <div style={{
                                minHeight: 360,
                                border: modelImage ? '1px solid var(--border)' : '1px dashed var(--border)',
                                borderRadius: 12,
                                background: 'var(--bg-secondary)',
                                display: 'flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                                overflow: 'hidden',
                                position: 'relative'
                            }}>
                                {modelImage ? (
                                    <>
                                        <img src={modelImage} alt="Model preview" style={{ width: '100%', height: 360, objectFit: 'contain' }} />
                                        <button
                                            className="btn btn-secondary btn-sm"
                                            style={{ position: 'absolute', right: 10, top: 10 }}
                                            onClick={() => setModelImage(null)}
                                            aria-label="Remove model image"
                                        >
                                            <X size={14} />
                                        </button>
                                    </>
                                ) : (
                                    <div style={{ textAlign: 'center', padding: 30, color: 'var(--text-secondary)' }}>
                                        <User size={38} style={{ marginBottom: 10 }} />
                                        <div style={{ fontWeight: 600, color: 'var(--text-primary)' }}>Upload a clear full-body photo</div>
                                        <div style={{ fontSize: 12, marginTop: 5 }}>Front-facing photos with good lighting work best.</div>
                                    </div>
                                )}
                            </div>
                        </div>

                        {/* STEP 2: CLOTHING PHOTO */}
                        <div className="card">
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12, alignItems: 'center', marginBottom: 14 }}>
                                <div>
                                    <div style={{ fontSize: 11, textTransform: 'uppercase', letterSpacing: '.1em', color: 'var(--text-muted)' }}>Step 2</div>
                                    <h2 style={{ margin: '4px 0 0', fontSize: 18 }}>Clothing Photo</h2>
                                </div>
                                {clothingImage && <span className="badge badge-success"><Check size={12} /> Ready</span>}
                            </div>

                            <button
                                className="btn btn-primary btn-sm"
                                style={{ marginBottom: 12 }}
                                onClick={() => clothingInputRef.current?.click()}
                            >
                                <Upload size={15} /> Upload Clothing
                            </button>

                            <input
                                ref={clothingInputRef}
                                type="file"
                                accept="image/jpeg,image/png,image/webp"
                                hidden
                                onChange={event => handleImageSelect(event, 'clothing')}
                            />

                            <div style={{ marginBottom: 12 }}>
                                <label style={{ display: 'block', fontSize: 12, color: 'var(--text-secondary)', marginBottom: 7 }}>
                                    Garment type
                                </label>
                                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 6 }}>
                                    {[
                                        ['upper_body', 'Upper'],
                                        ['lower_body', 'Lower'],
                                        ['dresses', 'Dress']
                                    ].map(([id, label]) => {
                                        const hasGarment = id === category
                                            ? Boolean(clothingImage || garmentsByCategory[id]?.image)
                                            : Boolean(garmentsByCategory[id]?.image)
                                        return (
                                            <button
                                                key={id}
                                                className={`btn btn-sm ${category === id ? 'btn-primary' : 'btn-secondary'}`}
                                                onClick={() => {
                                                    if (id === category) return
                                                    // Save the current slot first (including a garment loaded from Wardrobe).
                                                    if (clothingImage) {
                                                        setGarmentsByCategory(prev => ({
                                                            ...prev,
                                                            [category]: {
                                                                image: clothingImage,
                                                                name: garmentName || prev[category]?.name || 'Uploaded garment',
                                                                category
                                                            }
                                                        }))
                                                    }
                                                    const nextGarment = garmentsByCategory[id]
                                                    setCategory(id)
                                                    setClothingImage(nextGarment?.image || null)
                                                    setGarmentName(nextGarment?.name || '')
                                                    setResultImage(null)
                                                }}
                                            >
                                                {label}{hasGarment ? ' ✓' : ''}
                                            </button>
                                        )
                                    })}
                                </div>
                                <p style={{ fontSize: 11, color: 'var(--text-muted)', margin: '7px 0 0', lineHeight: 1.45 }}>
                                    Upload an item for Upper, then switch to Lower and upload another. Both slots stay selected for a combined preview.
                                </p>
                            </div>

                            <div style={{
                                minHeight: 360,
                                border: clothingImage ? '1px solid var(--border)' : '1px dashed var(--border)',
                                borderRadius: 12,
                                background: 'var(--bg-secondary)',
                                display: 'flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                                overflow: 'hidden',
                                position: 'relative'
                            }}>
                                {clothingImage ? (
                                    <>
                                        <img src={clothingImage} alt="Clothing preview" style={{ width: '100%', height: 360, objectFit: 'contain' }} />
                                        <button
                                            className="btn btn-secondary btn-sm"
                                            style={{ position: 'absolute', right: 10, top: 10 }}
                                            onClick={() => { setClothingImage(null); setGarmentName('') }}
                                            aria-label="Remove clothing image"
                                        >
                                            <X size={14} />
                                        </button>
                                    </>
                                ) : (
                                    <div style={{ textAlign: 'center', padding: 30, color: 'var(--text-secondary)' }}>
                                        <Upload size={38} style={{ marginBottom: 10 }} />
                                        <div style={{ fontWeight: 600, color: 'var(--text-primary)' }}>Upload one garment photo</div>
                                        <div style={{ fontSize: 12, marginTop: 5 }}>Use a clear image with the complete garment visible.</div>
                                    </div>
                                )}
                            </div>
                        </div>

                        {/* STEP 3: AI RESULT */}
                        <div className="card">
                            <div style={{ marginBottom: 14 }}>
                                <div style={{ fontSize: 11, textTransform: 'uppercase', letterSpacing: '.1em', color: 'var(--text-muted)' }}>Step 3</div>
                                <h2 style={{ margin: '4px 0 0', fontSize: 18 }}>AI Result</h2>
                            </div>

                            <div style={{ display: 'flex', gap: 8, marginBottom: 12 }}>
                                <button
                                    className="btn btn-primary"
                                    style={{ flex: 1 }}
                                    onClick={generateTryOn}
                                    disabled={processing || !modelImage || !clothingImage}
                                >
                                    <Sparkles size={16} />
                                    {processing ? 'Generating...' : 'Generate Try-On'}
                                </button>

                                <button
                                    className="btn btn-secondary"
                                    onClick={() => setIsAdjusting(true)}
                                    disabled={!modelImage || !clothingImage}
                                    title="Custom resize & move garment position"
                                    style={{ display: 'flex', alignItems: 'center', gap: 6 }}
                                >
                                    <Move size={15} />
                                    Resize & Move
                                </button>
                            </div>

                            <div style={{
                                minHeight: 360,
                                border: '1px solid var(--border)',
                                borderRadius: 12,
                                background: 'var(--bg-secondary)',
                                display: 'flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                                overflow: 'hidden'
                            }}>
                                {resultImage ? (
                                    <img src={resultImage} alt="IDM-VTON result" style={{ width: '100%', height: 360, objectFit: 'contain' }} />
                                ) : (
                                    <div style={{ textAlign: 'center', padding: 30, color: 'var(--text-secondary)' }}>
                                        {processing ? (
                                            <>
                                                <div className="spinner" style={{ margin: '0 auto 14px' }} />
                                                <div style={{ fontWeight: 600, color: 'var(--text-primary)' }}>AI is generating your outfit</div>
                                                <div style={{ fontSize: 12, marginTop: 5 }}>The GPU worker may take a few minutes.</div>
                                            </>
                                        ) : (
                                            <>
                                                <Sparkles size={34} style={{ marginBottom: 10 }} />
                                                <div style={{ fontWeight: 600, color: 'var(--text-primary)' }}>Your generated look appears here</div>
                                                <div style={{ fontSize: 12, marginTop: 5 }}>Both uploads are required before generation.</div>
                                            </>
                                        )}
                                    </div>
                                )}
                            </div>

                            {resultImage && (
                                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 6, marginTop: 12 }}>
                                    <button className="btn btn-primary btn-sm" onClick={downloadResult} title="Download try-on result">
                                        <Download size={14} /> Download
                                    </button>
                                    <button className="btn btn-secondary btn-sm" onClick={() => setIsAdjusting(true)} style={{ borderColor: 'var(--accent)' }} title="Custom resize & move garment">
                                        <Move size={14} color="var(--accent)" /> Adjust Fit
                                    </button>
                                    <button className="btn btn-secondary btn-sm" onClick={saveResult} disabled={saving} title="Save look to history">
                                        <Save size={14} /> {saving ? 'Saving...' : 'Save'}
                                    </button>
                                    <button className="btn btn-secondary btn-sm" onClick={clearSession} title="Start new try-on session">
                                        <RefreshCw size={14} /> New
                                    </button>
                                </div>
                            )}
                        </div>
                    </section>

                    {history.length > 0 && (
                        <section style={{ marginTop: 24 }}>
                            <div style={{ marginBottom: 12 }}>
                                <h2 style={{ margin: 0, fontSize: 18 }}>Recent Try-Ons</h2>
                                <p style={{ margin: '4px 0 0', color: 'var(--text-secondary)', fontSize: 13 }}>
                                    Saved looks from your account.
                                </p>
                            </div>

                            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(170px, 1fr))', gap: 12 }}>
                                {history.map(item => (
                                    <div className="card" key={item._id}>
                                        <img src={item.resultImage} alt={item.title || 'Saved try-on'} style={{ width: '100%', aspectRatio: '3/4', objectFit: 'cover', borderRadius: 10 }} />
                                        <div style={{ marginTop: 8, fontSize: 12, color: 'var(--text-secondary)' }}>{item.title}</div>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}
                </>

            {cameraOpen && (
                <div style={{
                    position: 'fixed',
                    inset: 0,
                    zIndex: 1000,
                    background: 'rgba(0,0,0,.72)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    padding: 20
                }}>
                    <div className="card" style={{ width: 'min(700px, 100%)' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 14 }}>
                            <h2 style={{ margin: 0, fontSize: 18 }}>Capture Model Photo</h2>
                            <button className="btn btn-secondary btn-sm" onClick={closeCamera}><X size={14} /></button>
                        </div>

                        <video
                            ref={videoRef}
                            autoPlay
                            playsInline
                            muted
                            style={{
                                width: '100%',
                                aspectRatio: '3/4',
                                objectFit: 'cover',
                                background: '#08080a',
                                borderRadius: 12
                            }}
                        />

                        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 12 }}>
                            <button className="btn btn-secondary" onClick={closeCamera}>Cancel</button>
                            <button className="btn btn-primary" onClick={captureCamera}><Camera size={15} /> Capture</button>
                        </div>
                    </div>
                </div>
            )}
        </main>
    )
}
